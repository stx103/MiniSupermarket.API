      CREATE TABLE "Orders" (&#xD;
          "OrderId" INTEGER NOT NULL CONSTRAINT "PK_Orders" PRIMARY KEY AUTOINCREMENT,&#xD;
          "OrderCode" varchar(30) NOT NULL DEFAULT '',&#xD;
          "RewardPoints" INTEGER NOT NULL DEFAULT 0,&#xD;
          "RedeemedPoints" INTEGER NOT NULL DEFAULT 0,&#xD;
          "DiscountAmount" decimal(18,2) NOT NULL DEFAULT '0.0',&#xD;
          "FinalAmount" AS ([TotalAmount] - [DiscountAmount]) STORED,&#xD;
          "OrderDate" TEXT NOT NULL DEFAULT (SYSDATETIME()),&#xD;
          "CustomerId" INTEGER NULL,&#xD;
          "UserId" INTEGER NOT NULL,&#xD;
          "TotalAmount" decimal(18,2) NOT NULL DEFAULT '0.0',&#xD;
          "Status" TEXT NOT NULL DEFAULT 'Ho�n t?t',&#xD;
          CONSTRAINT "CK_Orders_Discount" CHECK (DiscountAmount &gt;= 0 AND DiscountAmount &lt;= TotalAmount),&#xD;
          CONSTRAINT "CK_Orders_RedeemedPoints" CHECK (RedeemedPoints &gt;= 0),&#xD;
          CONSTRAINT "FK_Orders_Customers_CustomerId" FOREIGN KEY ("CustomerId") REFERENCES "Customers" ("CustomerId") ON DELETE SET NULL,&#xD;
          CONSTRAINT "FK_Orders_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("UserId") ON DELETE RESTRICT&#xD;
      );&#xD;
