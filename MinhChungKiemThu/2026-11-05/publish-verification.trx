      SELECT "t"."OrderId", "t"."CustomerId", "t"."DiscountAmount", "t"."FinalAmount", "t"."OrderCode", "t"."OrderDate", "t"."RedeemedPoints", "t"."RewardPoints", "t"."Status", "t"."TotalAmount", "t"."UserId", "t"."UserId0", "t"."Email", "t"."FullName", "t"."IsActive", "t"."Password", "t"."Role", "t"."Username", "t"."CustomerId0", "t"."Address", "t"."CreatedAt", "t"."CustomerName", "t"."MembershipRank", "t"."PhoneNumber", "t"."RewardPoints0", "t0"."OrderDetailId", "t0"."LineTotal", "t0"."OrderId", "t0"."ProductId", "t0"."Quantity", "t0"."UnitPrice", "t0"."ProductId0", "t0"."Barcode", "t0"."CategoryId", "t0"."Price", "t0"."ProductName", "t0"."StockQuantity"&#xD;
      FROM (&#xD;
          SELECT "o"."OrderId", "o"."CustomerId", "o"."DiscountAmount", "o"."FinalAmount", "o"."OrderCode", "o"."OrderDate", "o"."RedeemedPoints", "o"."RewardPoints", "o"."Status", "o"."TotalAmount", "o"."UserId", "u"."UserId" AS "UserId0", "u"."Email", "u"."FullName", "u"."IsActive", "u"."Password", "u"."Role", "u"."Username", "c"."CustomerId" AS "CustomerId0", "c"."Address", "c"."CreatedAt", "c"."CustomerName", "c"."MembershipRank", "c"."PhoneNumber", "c"."RewardPoints" AS "RewardPoints0"&#xD;
          FROM "Orders" AS "o"&#xD;
          INNER JOIN "Users" AS "u" ON "o"."UserId" = "u"."UserId"&#xD;
          LEFT JOIN "Customers" AS "c" ON "o"."CustomerId" = "c"."CustomerId"&#xD;
          WHERE "o"."OrderId" = @__id_0&#xD;
          LIMIT 1&#xD;
      ) AS "t"&#xD;
      LEFT JOIN (&#xD;
          SELECT "o0"."OrderDetailId", "o0"."LineTotal", "o0"."OrderId", "o0"."ProductId", "o0"."Quantity", "o0"."UnitPrice", "p"."ProductId" AS "ProductId0", "p"."Barcode", "p"."CategoryId", "p"."Price", "p"."ProductName", "p"."StockQuantity"&#xD;
          FROM "OrderDetails" AS "o0"&#xD;
          INNER JOIN "Products" AS "p" ON "o0"."ProductId" = "p"."ProductId"&#xD;
      ) AS "t0" ON "t"."OrderId" = "t0"."OrderId"&#xD;
      ORDER BY "t"."OrderId", "t"."UserId0", "t"."CustomerId0", "t0"."OrderDetailId"&#xD;
