      CREATE TABLE "Categories" (&#xD;
          "CategoryId" INTEGER NOT NULL CONSTRAINT "PK_Categories" PRIMARY KEY AUTOINCREMENT,&#xD;
          "CategoryName" TEXT NOT NULL,&#xD;
          "Description" TEXT NULL&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      CREATE TABLE "Customers" (&#xD;
          "CustomerId" INTEGER NOT NULL CONSTRAINT "PK_Customers" PRIMARY KEY AUTOINCREMENT,&#xD;
          "CreatedAt" TEXT NULL,&#xD;
          "CustomerName" TEXT NOT NULL,&#xD;
          "PhoneNumber" varchar(15) NOT NULL,&#xD;
          "Address" TEXT NOT NULL,&#xD;
          "RewardPoints" INTEGER NOT NULL DEFAULT 0,&#xD;
          "MembershipRank" TEXT NOT NULL DEFAULT 'Chu?n',&#xD;
          CONSTRAINT "CK_Customers_Address_FourParts" CHECK ([Address] LIKE '%,%,%,%' AND [Address] NOT LIKE '%,%,%,%,%')&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      CREATE TABLE "Users" (&#xD;
          "UserId" INTEGER NOT NULL CONSTRAINT "PK_Users" PRIMARY KEY AUTOINCREMENT,&#xD;
          "Username" TEXT NOT NULL,&#xD;
          "FullName" TEXT NOT NULL,&#xD;
          "Email" TEXT NULL,&#xD;
          "Password" TEXT NOT NULL,&#xD;
          "Role" TEXT NOT NULL DEFAULT 'Cashier',&#xD;
          "IsActive" INTEGER NOT NULL DEFAULT 1&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      CREATE TABLE "Products" (&#xD;
          "ProductId" INTEGER NOT NULL CONSTRAINT "PK_Products" PRIMARY KEY AUTOINCREMENT,&#xD;
          "Barcode" TEXT NOT NULL,&#xD;
          "ProductName" TEXT NOT NULL,&#xD;
          "Price" decimal(18,2) NOT NULL,&#xD;
          "StockQuantity" INTEGER NOT NULL DEFAULT 0,&#xD;
          "CategoryId" INTEGER NOT NULL,&#xD;
          CONSTRAINT "CK_Products_Price_Positive" CHECK (Price &gt; 0),&#xD;
          CONSTRAINT "CK_Products_Stock_Nonnegative" CHECK (StockQuantity &gt;= 0),&#xD;
          CONSTRAINT "FK_Products_Categories_CategoryId" FOREIGN KEY ("CategoryId") REFERENCES "Categories" ("CategoryId") ON DELETE RESTRICT&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
      CREATE TABLE "Orders" (&#xD;
          "OrderId" INTEGER NOT NULL CONSTRAINT "PK_Orders" PRIMARY KEY AUTOINCREMENT,&#xD;
          "OrderCode" varchar(30) NOT NULL DEFAULT '',&#xD;
          "RewardPoints" INTEGER NOT NULL DEFAULT 0,&#xD;
          "RedeemedPoints" INTEGER NOT NULL DEFAULT 0,&#xD;
          "DiscountAmount" decimal(18,2) NOT NULL DEFAULT '0.0',&#xD;
          "FinalAmount" AS ([TotalAmount] - [DiscountAmount]) STORED,&#xD;
          "OrderDate" TEXT NOT NULL DEFAULT (SYSDATETIME()),&#xD;
          "CustomerId" INTEGER NULL,&#xD;
          "UserId" INTEGER NOT NULL,&#xD;
          "TotalAmount" decimal(18,2) NOT NULL DEFAULT '0.0',&#xD;
          "Status" TEXT NOT NULL DEFAULT 'Ho�n t?t',&#xD;
          CONSTRAINT "CK_Orders_Discount" CHECK (DiscountAmount &gt;= 0 AND DiscountAmount &lt;= TotalAmount),&#xD;
          CONSTRAINT "CK_Orders_RedeemedPoints" CHECK (RedeemedPoints &gt;= 0),&#xD;
          CONSTRAINT "FK_Orders_Customers_CustomerId" FOREIGN KEY ("CustomerId") REFERENCES "Customers" ("CustomerId") ON DELETE SET NULL,&#xD;
          CONSTRAINT "FK_Orders_Users_UserId" FOREIGN KEY ("UserId") REFERENCES "Users" ("UserId") ON DELETE RESTRICT&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
